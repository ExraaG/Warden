{
  "name": "warden-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "stamp-version": "node ../scripts/stamp-version.js || true",
    "dev": "npm run stamp-version && rm -rf .next && tsx watch src/server.ts",
    "build:next": "next build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:fast": "NEXT_TELEMETRY_DISABLED=1 next build --no-lint && npm run build:server",
    "build": "npm run stamp-version && npm run build:fast",
    "db:reset": "rm -f data/warden_storage.json",
    "start": "NODE_ENV=production node dist-server/server.js"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.28.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.31.0",
    "next": "^14.2.5",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "otplib": "^13.4.1",
    "pidusage": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/pidusage": "^2.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.3.3"
  }
}
