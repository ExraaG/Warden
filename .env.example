# Warden API Configuration (Secures REST endpoints & External Clients)
WARDEN_API_KEY=your_secure_warden_api_key_here

# System & Web UI Settings (Default 22313 = WDN / WARDEN)
PORT=22313
TZ=Europe/Vienna
DATA_DIR=/data
DEV_FIXTURE_MODE=false

# Minecraft Server Port (Change if 25565 is already used by another server on your machine)
MC_PORT=25565

