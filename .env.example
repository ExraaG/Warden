# Crafty Controller API Configuration
CRAFTY_URL=https://your-crafty-ip-or-hostname:8443
CRAFTY_API_KEY=your_long_lived_crafty_api_bearer_token

# Warden API Configuration (Secures Mobile & External Clients)
WARDEN_API_KEY=your_secure_warden_api_key_here

# System Settings
PORT=3000
TZ=America/New_York
DATA_DIR=/data
DEV_FIXTURE_MODE=false
